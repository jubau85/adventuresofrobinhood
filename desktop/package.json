{
  "name": "a-knights-tale",
  "productName": "A Knight's Tale",
  "version": "0.7.0",
  "description": "Mittelalterliches Ritter-Aufbauspiel (Desktop-Fassung)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "spiel": "node ../tools/build.mjs --desktop game",
    "start": "npm run spiel && electron .",
    "start:zweite": "electron . --zweite",
    "dist:win": "npm run spiel && electron-builder --win nsis zip",
    "dist:linux": "npm run spiel && electron-builder --linux AppImage tar.gz",
    "dist:mac": "npm run spiel && electron-builder --mac zip",
    "dist:setup": "node build-setup.mjs"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.aknightstale.game",
    "productName": "A Knight's Tale",
    "files": [
      "main.js",
      "preload.js",
      "relay.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.games"
    }
  }
}
